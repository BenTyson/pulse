---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPIC_HUBS, getTopicCounts } from '../../lib/supabase';

const topicCounts = await getTopicCounts();

// Color mapping for topic cards
const colorClasses: Record<string, { bg: string; border: string; text: string }> = {
  amber: { bg: 'bg-amber-500/10', border: 'border-amber-500/30', text: 'text-amber-400' },
  blue: { bg: 'bg-blue-500/10', border: 'border-blue-500/30', text: 'text-blue-400' },
  purple: { bg: 'bg-purple-500/10', border: 'border-purple-500/30', text: 'text-purple-400' },
  emerald: { bg: 'bg-emerald-500/10', border: 'border-emerald-500/30', text: 'text-emerald-400' },
  rose: { bg: 'bg-rose-500/10', border: 'border-rose-500/30', text: 'text-rose-400' },
};
---

<BaseLayout
  title="Topic Hubs"
  description="Explore graphene news and research organized by topic: batteries, electronics, composites, production methods, and fundamental research."
>
  <main class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-12">
        <h1 class="text-4xl font-bold text-silver-bright mb-4">Topic Hubs</h1>
        <p class="text-lg text-text-secondary max-w-3xl">
          Explore graphene news and research organized by application area. Each hub contains curated articles, related companies, and educational resources.
        </p>
      </header>

      <!-- Topic Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {TOPIC_HUBS.map((topic) => {
          const colors = colorClasses[topic.color] || colorClasses.blue;
          const articleCount = topicCounts[topic.slug] || 0;

          return (
            <a
              href={`/topics/${topic.slug}`}
              class={`group block p-6 rounded-xl border ${colors.border} ${colors.bg} hover:bg-opacity-20 transition-all duration-200`}
            >
              <div class="flex items-start gap-4">
                <div class={`p-3 rounded-lg ${colors.bg} ${colors.text}`}>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={topic.icon} />
                  </svg>
                </div>
                <div class="flex-1">
                  <h2 class="text-xl font-semibold text-silver-bright group-hover:text-white transition-colors mb-2">
                    {topic.title}
                  </h2>
                  <p class="text-text-secondary text-sm line-clamp-2 mb-4">
                    {topic.description}
                  </p>
                  <div class="flex items-center gap-4 text-sm">
                    <span class={`${colors.text} font-medium`}>
                      {articleCount} article{articleCount !== 1 ? 's' : ''}
                    </span>
                    <span class="flex items-center gap-1 text-text-muted group-hover:text-silver transition-colors">
                      Explore
                      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Additional Info -->
      <section class="mt-16 p-8 bg-bg-surface rounded-xl border border-bg-surface-light">
        <h2 class="text-xl font-semibold text-silver-bright mb-4">About Topic Hubs</h2>
        <p class="text-text-secondary mb-4">
          Our topic hubs automatically categorize graphene news based on article content and tags. Each hub provides:
        </p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-text-secondary">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Curated news feed filtered by topic</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Related companies working in the space</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Educational wiki resources</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Key statistics and trends</span>
          </li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
