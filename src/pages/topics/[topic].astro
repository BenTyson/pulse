---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { TOPIC_HUBS, getArticlesByTopic, getCompaniesByTopic, getWikiPages } from '../../lib/supabase';

const { topic: topicSlug } = Astro.params;

// Find the topic configuration
const topic = TOPIC_HUBS.find((t) => t.slug === topicSlug);

if (!topic) {
  return Astro.redirect('/topics');
}

// Fetch topic-related data
const articles = await getArticlesByTopic(topicSlug, { limit: 12 });
const companies = await getCompaniesByTopic(topicSlug, { limit: 6 });
const wikiPages = await getWikiPages();

// Color mapping
const colorClasses: Record<string, { bg: string; border: string; text: string; badge: string }> = {
  amber: { bg: 'bg-amber-500/10', border: 'border-amber-500/30', text: 'text-amber-400', badge: 'bg-amber-500/20 text-amber-400 border-amber-500/30' },
  blue: { bg: 'bg-blue-500/10', border: 'border-blue-500/30', text: 'text-blue-400', badge: 'bg-blue-500/20 text-blue-400 border-blue-500/30' },
  purple: { bg: 'bg-purple-500/10', border: 'border-purple-500/30', text: 'text-purple-400', badge: 'bg-purple-500/20 text-purple-400 border-purple-500/30' },
  emerald: { bg: 'bg-emerald-500/10', border: 'border-emerald-500/30', text: 'text-emerald-400', badge: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' },
  rose: { bg: 'bg-rose-500/10', border: 'border-rose-500/30', text: 'text-rose-400', badge: 'bg-rose-500/20 text-rose-400 border-rose-500/30' },
};

const colors = colorClasses[topic.color] || colorClasses.blue;

// Related wiki pages mapping
const wikiMapping: Record<string, string[]> = {
  batteries: ['graphene-batteries', 'supercapacitors'],
  electronics: ['properties', 'applications'],
  composites: ['composites', 'coatings'],
  production: ['production-methods', 'graphene-oxide'],
  research: ['properties', 'introduction'],
};

const relatedWikiSlugs = wikiMapping[topicSlug] || [];
const relatedWiki = wikiPages.filter((page) =>
  relatedWikiSlugs.some((slug) => page.slug.includes(slug))
);
---

<BaseLayout
  title={`${topic.title} | Topic Hub`}
  description={topic.description}
>
  <main class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <header class={`p-8 rounded-xl border ${colors.border} ${colors.bg} mb-12`}>
        <nav class="flex items-center gap-2 text-sm text-text-muted mb-6">
          <a href="/" class="hover:text-silver transition-colors">Home</a>
          <span>/</span>
          <a href="/topics" class="hover:text-silver transition-colors">Topics</a>
          <span>/</span>
          <span class={colors.text}>{topic.title}</span>
        </nav>

        <div class="flex items-start gap-6">
          <div class={`p-4 rounded-xl ${colors.bg} ${colors.text} hidden sm:block`}>
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={topic.icon} />
            </svg>
          </div>
          <div class="flex-1">
            <h1 class="text-4xl font-bold text-silver-bright mb-4">{topic.title}</h1>
            <p class="text-lg text-text-secondary max-w-3xl mb-6">
              {topic.description}
            </p>
            <div class="flex flex-wrap gap-4 text-sm">
              <span class={`px-3 py-1 rounded-full border ${colors.badge}`}>
                {articles.length} article{articles.length !== 1 ? 's' : ''}
              </span>
              {companies.length > 0 && (
                <span class="px-3 py-1 rounded-full border border-border bg-bg-surface text-text-secondary">
                  {companies.length} compan{companies.length !== 1 ? 'ies' : 'y'}
                </span>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Articles Column -->
        <div class="lg:col-span-2">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-silver-bright">Latest Articles</h2>
            {articles.length > 6 && (
              <span class="text-sm text-text-muted">Showing {Math.min(articles.length, 12)} of {articles.length}</span>
            )}
          </div>

          {articles.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {articles.map((article, index) => (
                <div class:list={[
                  "rounded-lg border border-border bg-bg-surface/50 hover:bg-bg-surface hover:border-border-light transition-all",
                  index === 0 && "md:col-span-2"
                ]}>
                  <ArticleCard article={article} featured={index === 0} index={index} />
                </div>
              ))}
            </div>
          ) : (
            <div class="p-8 bg-bg-surface rounded-xl border border-bg-surface-light text-center">
              <p class="text-text-secondary mb-4">No articles found for this topic yet.</p>
              <p class="text-text-muted text-sm">Check back soon as we continue to add content.</p>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="space-y-8">
          <!-- Related Companies -->
          {companies.length > 0 && (
            <section class="p-6 bg-bg-surface rounded-xl border border-bg-surface-light">
              <h3 class="text-lg font-semibold text-silver-bright mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                Related Companies
              </h3>
              <ul class="space-y-3">
                {companies.map((company) => (
                  <li>
                    <a href={`/companies#${company.slug}`} class="group flex items-start gap-3">
                      <div class="w-8 h-8 rounded bg-bg-surface-light flex items-center justify-center text-xs font-bold text-text-muted flex-shrink-0">
                        {company.name.charAt(0)}
                      </div>
                      <div class="flex-1 min-w-0">
                        <span class="block text-sm font-medium text-silver group-hover:text-silver-bright transition-colors truncate">
                          {company.name}
                        </span>
                        <span class="block text-xs text-text-muted capitalize">
                          {company.company_type}
                        </span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/companies" class="mt-4 inline-flex items-center gap-1 text-sm text-text-muted hover:text-silver transition-colors">
                View all companies
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </section>
          )}

          <!-- Related Wiki Pages -->
          {relatedWiki.length > 0 && (
            <section class="p-6 bg-bg-surface rounded-xl border border-bg-surface-light">
              <h3 class="text-lg font-semibold text-silver-bright mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                Learn More
              </h3>
              <ul class="space-y-2">
                {relatedWiki.map((page) => (
                  <li>
                    <a href={`/wiki/${page.slug}`} class="flex items-center gap-2 text-sm text-text-secondary hover:text-silver transition-colors">
                      <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      {page.title}
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/wiki" class="mt-4 inline-flex items-center gap-1 text-sm text-text-muted hover:text-silver transition-colors">
                Browse all wiki pages
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </section>
          )}

          <!-- Keywords -->
          <section class="p-6 bg-bg-surface rounded-xl border border-bg-surface-light">
            <h3 class="text-lg font-semibold text-silver-bright mb-4">Related Keywords</h3>
            <div class="flex flex-wrap gap-2">
              {topic.keywords.slice(0, 8).map((keyword) => (
                <span class="px-2 py-1 bg-bg-surface-light rounded text-xs text-text-muted">
                  {keyword}
                </span>
              ))}
            </div>
          </section>

          <!-- Other Topics -->
          <section class="p-6 bg-bg-surface rounded-xl border border-bg-surface-light">
            <h3 class="text-lg font-semibold text-silver-bright mb-4">Other Topics</h3>
            <ul class="space-y-2">
              {TOPIC_HUBS.filter((t) => t.slug !== topicSlug).map((otherTopic) => {
                const otherColors = colorClasses[otherTopic.color];
                return (
                  <li>
                    <a href={`/topics/${otherTopic.slug}`} class="flex items-center gap-2 text-sm text-text-secondary hover:text-silver transition-colors">
                      <svg class={`w-4 h-4 ${otherColors?.text || 'text-text-muted'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={otherTopic.icon} />
                      </svg>
                      {otherTopic.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
